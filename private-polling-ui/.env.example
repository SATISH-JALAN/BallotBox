# Copy to .env.local for `npm run dev` overrides (gitignored).

# Midnight network: "preprod" or "preview"
VITE_NETWORK_ID=preprod

# Pino logger level: trace | debug | info | warn | error
VITE_LOGGING_LEVEL=info

# Featured poll on the landing page (from deployments/preprod.json after deploying)
VITE_CONTRACT_ADDRESS=

# Links — unset links are hidden in the UI
VITE_X_URL=https://x.com/BallotMidnightt
VITE_GITHUB_URL=https://github.com/SATISH-JALAN/BallotBox
# VITE_USER_GUIDE_URL=
# VITE_EXPLORER_TX_URL=https://<explorer>/tx/{tx}

# Indexer used for the wallet-free poll preview (defaults to the public indexer for VITE_NETWORK_ID)
# VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
