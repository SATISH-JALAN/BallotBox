# Build-time config for `vite build --mode preprod` (committed; contains no secrets).
# On Vercel the same variables can be overridden in Project Settings → Environment Variables.
VITE_NETWORK_ID=preprod
VITE_LOGGING_LEVEL=info

# Featured poll shown on the landing page. Set after `npm run deploy-direct` —
# the address is also written to deployments/preprod.json.
VITE_CONTRACT_ADDRESS=7423df36535c53ec590fd268f36771b9b9bd63ab741706062ac820f7b59f9351

# Product links (leave blank to hide)
VITE_X_URL=
VITE_FEEDBACK_URL=
VITE_GITHUB_URL=https://github.com/SATISH-JALAN/BallotBox
# VITE_EXPLORER_TX_URL=https://<explorer>/tx/{tx}
