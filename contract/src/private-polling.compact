pragma language_version 0.23.0;

import CompactStandardLibrary;

export enum PollState { CLOSED, OPEN }

export ledger pollState: PollState;
export ledger pollQuestion: Maybe<Opaque<"string">>;
export ledger yesVotes: Counter;
export ledger noVotes: Counter;
export ledger abstainVotes: Counter;
export ledger owner: Bytes<32>;
export ledger sequence: Counter;

// Nullifiers already spent in the current poll. Rejecting a repeat is what makes a
// ballot one-per-credential without ever identifying the credential.
export ledger spentNullifiers: Set<Bytes<32>>;

// Identifies the current poll. Every nullifier is bound to it, so a credential spent
// in one poll cannot be replayed in the next — and the same voter's nullifiers across
// two polls are unlinkable.
export ledger pollId: Bytes<32>;

witness localSecretKey(): Bytes<32>;

export circuit derivedPublicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([sk, sequence]);
}

// Domain-separated from `derivedPublicKey` by the "nullifier" tag, so a nullifier can
// never collide with an owner hash derived from the same secret key.
export circuit voteNullifier(sk: Bytes<32>, poll: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    persistentHash<Vector<2, Bytes<32>>>([sk, poll]),
    pad(32, "nullifier")
  ]);
}

constructor() {
  pollState = PollState.CLOSED;
  pollQuestion = none<Opaque<"string">>();
  owner = pad(32, "0");
  pollId = pad(32, "0");
}

export circuit createPoll(question: Opaque<"string">): [] {
  assert(pollState == PollState.CLOSED, "A poll is already open");
  pollQuestion = some<Opaque<"string">>(disclose(question));
  pollState = PollState.OPEN;
  sequence.increment(1);
  const ownerKey = disclose(derivedPublicKey(localSecretKey(), pad(32, "0")));
  owner = ownerKey;

  // Fresh poll identity, so nullifiers from a previous poll on this contract cannot
  // be replayed against this one.
  pollId = disclose(persistentHash<Vector<2, Bytes<32>>>([ownerKey, pad(32, "poll")]));

  // Clear the spent set for the new poll.
  spentNullifiers.resetToDefault();
}

export circuit castVote(choice: Uint<8>): [] {
  assert(pollState == PollState.OPEN, "Poll is not currently open");
  assert(choice <= 2, "Invalid choice: 0=Yes, 1=No, 2=Abstain");

  // One ballot per secret key, per poll. The nullifier is a one-way hash of a secret
  // the chain never sees, so it enforces this without identifying the voter.
  const nullifier = disclose(voteNullifier(localSecretKey(), pollId));
  assert(!spentNullifiers.member(nullifier), "This key has already voted in this poll");
  spentNullifiers.insert(nullifier);

  const publicChoice = disclose(choice);
  if (publicChoice == 0) {
    yesVotes.increment(1);
  } else if (publicChoice == 1) {
    noVotes.increment(1);
  } else {
    abstainVotes.increment(1);
  }
}

export circuit closePoll(): [] {
  assert(pollState == PollState.OPEN, "Poll is not currently open");
  const callerPk = disclose(derivedPublicKey(localSecretKey(), pad(32, "0")));
  assert(callerPk == owner, "Only the poll creator can close the poll");
  pollState = PollState.CLOSED;
}
