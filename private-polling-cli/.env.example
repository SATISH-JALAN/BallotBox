# Copy to .env (gitignored) — read by deploy-direct, verify, export-participants, preprod-remote.

# Hex seed (64 chars) of a Preprod wallet funded with tNIGHT from
# https://faucet.preprod.midnight.network/  — NEVER commit a real seed.
MIDNIGHT_WALLET_SEED=

# Encrypts the local LevelDB private state (organizer/voter secret keys).
PRIVATE_STATE_PASSWORD=change-me-to-something-long

# Optional: start a public open-enrollment poll right after deploying.
DEMO_POLL_QUESTION=Should Midnight dApps default to private-by-design voting?
DEMO_POLL_DAYS=14

# Optional endpoint overrides (defaults target Preprod + a local proof server on :6300)
# PROOF_SERVER_URL=http://127.0.0.1:6300
# INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# NODE_URL=https://rpc.preprod.midnight.network
