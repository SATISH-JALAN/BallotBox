{
  "name": "@midnight-ntwrk/private-polling-cli",
  "version": "0.1.0",
  "author": "Satish Jalan",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -R ../contract/src/managed dist/contract/src/managed",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "lint": "eslint src",
    "prepack": "npm run build",
    "standalone": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/standalone.ts",
    "preview-remote": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/preview.ts",
    "preprod-remote": "node --env-file-if-exists=.env --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/preprod.ts",
    "deploy-direct": "node --env-file-if-exists=.env --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/deploy-direct.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node --env-file-if-exists=.env --experimental-specifier-resolution=node --loader ts-node/esm src/verify-tally.ts",
    "export-participants": "node --env-file-if-exists=.env --experimental-specifier-resolution=node --loader ts-node/esm src/export-participants.ts",
    "e2e:standalone": "node --max-old-space-size=8192 --experimental-specifier-resolution=node --loader ts-node/esm src/e2e-standalone.ts"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.3.0"
  }
}
